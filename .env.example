# Database Connection (Not strictly required for SQLite local development, but needed for production PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/bharat_one?schema=public"

# Authentication Secrets
# JWT Secret should be a secure random 32-character string
JWT_SECRET="your-super-secret-jwt-signing-key-change-in-production"
AUTH_SECRET="your-session-encryption-auth-secret-key"

# Next.js Port (Default is 3000)
PORT=3000

# Google OAuth Credentials (for Google Login Integration)
GOOGLE_CLIENT_ID="your-google-oauth-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret-here"

# Email Notification API (Optional, e.g., SendGrid/Resend key)
EMAIL_API_KEY="your-email-api-key-here"

# Maps API (For CSC center and government offices locator fallback mapping)
MAPS_API_KEY="your-google-maps-api-key-here"
